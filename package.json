{
  "name": "github-copilot-codearts",
  "displayName": "github copilot codearts",
  "description": "将腾讯 CodeBuddy 国内版、阿里 Qoder 中国版、字节 TRAE 与 OpenRouter（可自选上游供应商）模型接入 VS Code Copilot Chat 与 Agent。",
  "version": "0.0.5",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:codebuddy",
    "onLanguageModelChatProvider:qodercn",
    "onLanguageModelChatProvider:trae",
    "onLanguageModelChatProvider:openrouter-byok"
  ],
  "repository": {
    "url": "https://github.com/DooQingYoo/github-copilot-codearts.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "codebuddy",
        "displayName": "CodeBuddy",
        "managementCommand": "github-copilot-codearts.manageCodeBuddy"
      },
      {
        "vendor": "qodercn",
        "displayName": "Qoder (中国版)",
        "managementCommand": "github-copilot-codearts.manageQoderCn"
      },
      {
        "vendor": "trae",
        "displayName": "TRAE (字节)",
        "managementCommand": "github-copilot-codearts.manageTrae"
      },
      {
        "vendor": "openrouter-byok",
        "displayName": "OpenRouter (可自选上游供应商)",
        "managementCommand": "github-copilot-codearts.manageOpenRouter"
      }
    ],
    "commands": [
      {
        "command": "github-copilot-codearts.manageCodeBuddy",
        "title": "CodeBuddy: 登录 / 管理账号"
      },
      {
        "command": "github-copilot-codearts.logoutCodeBuddy",
        "title": "CodeBuddy: 退出登录"
      },
      {
        "command": "github-copilot-codearts.manageQoderCn",
        "title": "Qoder (中国版): 登录 / 管理账号"
      },
      {
        "command": "github-copilot-codearts.logoutQoderCn",
        "title": "Qoder (中国版): 退出登录"
      },
      {
        "command": "github-copilot-codearts.manageTrae",
        "title": "TRAE (字节): 登录 / 管理账号"
      },
      {
        "command": "github-copilot-codearts.logoutTrae",
        "title": "TRAE (字节): 退出登录"
      },
      {
        "command": "github-copilot-codearts.manageOpenRouter",
        "title": "OpenRouter: 设置 API Key"
      },
      {
        "command": "github-copilot-codearts.logoutOpenRouter",
        "title": "OpenRouter: 清除 API Key"
      },
      {
        "command": "github-copilot-codearts.pickOpenRouterProvider",
        "title": "OpenRouter: 选择上游供应商"
      }
    ],
    "configuration": {
      "title": "github copilot codearts",
      "properties": {
        "github-copilot-codearts.openrouter.pinnedProviders": {
          "type": "object",
          "default": {},
          "markdownDescription": "按模型 id 指定 OpenRouter 的**上游供应商** slug（如 `{ \"deepseek/deepseek-v4.1-flash\": \"deepinfra/fp8\" }`）。\n\n指定的供应商会被严格锁定（`provider.order` 且**关闭回退**）：该家不可用时本轮请求会直接失败。\n\n留空或写 `\"auto\"` 表示交回 OpenRouter 按价格负载均衡。\n\n建议用命令 **OpenRouter: 选择上游供应商** 来设置（它会列出该模型当前真实可用的上下游）。",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "copy-wasm": "node -e \"require('fs').copyFileSync('src/qoder-cn-wasm.wasm','out/qoder-cn-wasm.wasm')\"",
    "compile": "tsc -p ./ && npm run copy-wasm",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}